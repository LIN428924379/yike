<?xml version="1.0" encoding="utf-8"?>
<!--
  到点提醒专用的状态栏图标。

  为什么要单独做一个：
  安卓要求通知的小图标是【单色剪影】—— 系统只取它的形状，然后自己上色。
  直接拿 App 图标（一个彩色的自适应图标）塞进去，会糊成一团；
  而且很多系统会把它缓存起来，于是你换了图标它还是显示旧的。

  形状就用 App 里那个"四分之三的环"：从正上方顺时针画 270°。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12,3.4 A8.6,8.6 0 1 1 3.4,12"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
</vector>
